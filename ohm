#!/bin/zsh
# shellcheck disable=SC2154,SC2086

[[ -n "$TURBO_PATH" ]] || { print "🛑Script aborted. TURBO_ZSH missing."; exit 250; }

set -u

OHM_PATH=${0:A:h}

info() {
  printf "\e[93;44;1m Ω \e[97;22m%s\e[K\e[0m\n" "$1"
}

ok() {
  printf "\e[97;44m  [OK] \e[37m%s\e[K\e[0m\n" "$1"
}

warn() {
  printf "  [WARN] %s\n" "$1"
}

err() {
  printf "  [FAIL] %s\n" "$1"
}

host_short() {
  if [[ -n "${HOST:-}" ]]; then
    echo "${HOST%%.*}"
  else
    hostname | cut -d. -f1
  fi
}

doctor() {
  local failed=0
  local warned=0
  local zshrc="${HOME}/.zshrc"
  local hook="source ${OHM_PATH}/init.zsh"

  info "Doctor"

  command -v zsh >/dev/null 2>&1 && ok "zsh available" || { err "zsh missing"; ((failed++)); }
  command -v git >/dev/null 2>&1 && ok "git available" || { err "git missing"; ((failed++)); }

  if [[ -f "${OHM_PATH}/init.zsh" ]]; then
    ok "init.zsh present"
  else
    err "Missing init.zsh"
    ((failed++))
  fi

  if [[ -d "${OHM_PATH}/menu_zsh" ]]; then
    ok "menu_zsh present"
  else
    err "menu_zsh missing (run ./setup)"
    ((failed++))
  fi

  local menu_launcher="${OHM_PATH}/menu_zsh/m"
  if [[ -f "$menu_launcher" ]]; then
    if [[ -x "$menu_launcher" ]]; then
      ok "menu launcher executable"
    else
      warn "menu launcher not executable; fixing with chmod +x"
      if chmod +x "$menu_launcher" 2>/dev/null; then
        ok "Fixed menu launcher permissions"
      else
        err "Unable to set execute permission on $menu_launcher"
        ((failed++))
      fi
      ((warned++))
    fi
  else
    err "Missing menu launcher: $menu_launcher"
    ((failed++))
  fi

  if [[ -d "${OHM_PATH}/turbo_zsh" ]]; then
    ok "turbo_zsh present"
  else
    err "turbo_zsh missing (run ./setup)"
    ((failed++))
  fi

  if [[ -f "$zshrc" ]] && grep -Fq "$hook" "$zshrc"; then
    ok "shell hook present in ~/.zshrc"
  else
    warn "shell hook missing from ~/.zshrc"
    echo "       Add: $hook"
    ((warned++))
  fi

  local zshenv="${HOME}/.zshenv"
  local ohm_hook="source ${OHM_PATH}/init_env.zsh"
  if [[ -f "$zshenv" ]] && grep -Fq "$ohm_hook" "$zshenv"; then
    ok "ohm env hook present in ~/.zshenv"
  else
    warn "ohm env hook missing from ~/.zshenv"
    echo "       Add: $ohm_hook"
    ((warned++))
  fi

  if (( failed > 0 )); then
    err "Doctor found ${failed} failure(s), ${warned} warning(s)"
    return 1
  fi

  info "Doctor Passed (${warned} warning(s))"
}

show_help() {
  cat <<EOF
Usage: ./ohm <command> [args]

Commands:
  doctor          Validate install and configuration
  config spinner  Configure default spinner style
  version         Print version information
  help            Show this help
EOF
}

main() {
  local cmd="${1:-help}"
  case "$cmd" in
    doctor)
      shift
      doctor "$@"
      ;;
    config)
      shift
      case "${1:-}" in
        spinner|--spinner)
          source "${OHM_PATH}/config" spinner
          ;;
        *)
          err "Unknown config subcommand: ${1:-<none>}"
          show_help
          return 1
          ;;
      esac
      ;;
    version)
      if [[ -f "${OHM_PATH}/version.zsh" ]]; then
        # shellcheck source=/dev/null
        source "${OHM_PATH}/version.zsh"
        if typeset -f OhmVersion >/dev/null 2>&1; then
          OhmVersion
        else
          err "version.zsh loaded but OhmVersion() is missing"
          return 1
        fi
      else
        err "Missing version.zsh"
        return 1
      fi
      ;;
    help|-h|--help)
      show_help
      ;;
    *)
      err "Unknown command: $cmd"
      show_help
      return 1
      ;;
  esac
}

main "$@"
