#!/bin/sh

# POSIX-compatible launcher for the zsh installer implementation.

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SETUP_ZSH="${SCRIPT_DIR}/setup.zsh"

if command -v zsh >/dev/null 2>&1; then
  exec zsh "$SETUP_ZSH" "$@"
fi

cat <<'EOF' >&2
Error: zsh is required to install ohm.

Please install zsh and run ./setup again.

Examples:
  macOS (Homebrew): brew install zsh
  Debian/Ubuntu:    sudo apt-get install zsh
  Fedora:           sudo dnf install zsh
  Alpine:           sudo apk add zsh
EOF
exit 2
