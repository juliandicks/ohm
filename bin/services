#!/bin/zsh
# shellcheck disable=SC2296,SC2154,SC1090,SC2046,SC2086

# services - List and display status of user-defined services
# Usage: see show_help function or run with -h

[[ -n "$TURBO_PATH" ]] || { print "🛑Script aborted. TURBO_ZSH missing."; exit 250; }

uses alerts_lib.zsh
uses string_lib.zsh
uses crt_lib.zsh

uses ohm_lib.zsh

source "$(EnvUserHost)" || {
  ErrorBar "Missing $(EnvUserHost)"
  exit 2
}

typeset -p SERVICE_LIST &>/dev/null || typeset -p SERVICE_CONTEXTS &>/dev/null || {
  ErrorBar "Please declare SERVICE_LIST or SERVICE_CONTEXTS in your environment file"
  exit 1
}

# --- Variable Initialization ---
labelWidth=0
mode=pretty
hide_ports=0
typeset -A ports=()
_cli_context=""
_active_context=""

# --- Context Resolution ---
resolve_service_list() {
  local context_name="$1"

  # Tier 1: CLI override via -c <name>
  if [[ -n "$context_name" ]]; then
    local var_name="SERVICES_${(U)context_name}"
    if typeset -p "$var_name" &>/dev/null; then
      eval "SERVICE_LIST=(\${(kv)${var_name}})"
      _active_context="${(U)context_name}"
      return 0
    fi
    ErrorBar "Unknown service context: $context_name (expected $var_name)"
    exit 1
  fi

  # Tier 2: Walk $PWD upward through SERVICE_CONTEXTS
  if typeset -p SERVICE_CONTEXTS &>/dev/null; then
    local dir="$PWD"
    while [[ "$dir" != "/" ]]; do
      if [[ -n "${SERVICE_CONTEXTS[$dir]:-}" ]]; then
        local var_name="${SERVICE_CONTEXTS[$dir]}"
        if typeset -p "$var_name" &>/dev/null; then
          eval "SERVICE_LIST=(\${(kv)${var_name}})"
          _active_context="${var_name#SERVICES_}"
          return 0
        fi
        ErrorBar "SERVICE_CONTEXTS[$dir] references undefined: $var_name"
        exit 1
      fi
      dir="${dir:h}"
    done
  fi

  # Tier 3: Fall through to SERVICE_LIST (backward compatible)
  _active_context=""
}

# --- Helper Functions ---
get_listening_ports() {
  if IsMac; then
    netstat -anp tcp | grep LISTEN | awk '{print $4}' | awk -F'.' '{print $NF}' | sort -nu
  else
    netstat -tln | grep LISTEN | awk '{print $4}' | awk -F':' '{print $NF}' | sort -nu
  fi
}

get_label_width() {
  for label in "${(k)SERVICE_LIST[@]}"; do
    (( ${#label} > labelWidth )) && labelWidth=${#label}
  done
}

show_help() {
  local APP=services
  cat <<EOF
Usage: $APP [OPTIONS]

Options:
  -h, --help         Show this help message and exit
  -c, --context NAME Use a named service context (SERVICES_<NAME>)
  -a, --all          List all services
  -r, --running      List only running services
  -s, --stopped      List only stopped services
  -np, --no-ports    Hide port numbers

Context Resolution:
  Without -c, the script checks SERVICE_CONTEXTS for directory mappings.
  It walks from \$PWD upward to find the first matching prefix.
  Falls back to SERVICE_LIST if no context matches.

Examples:
  $APP                  # auto-detect context from \$PWD
  $APP -c slack         # force SERVICES_SLACK context
  $APP -r               # running services (auto-detect)
  $APP -c agent -s      # stopped services in agent context
EOF
}

is_port_open() {
  [[ -n "${ports[$1]:-}" ]]
}

pretty_print() {
  CursorOff
  get_label_width

  local headerAttr="$Black;$(AsBg BrightWhite)"
  local dialogAttr="$BrightWhite;$(AsBg Blue)"
  local runAttr="$BrightWhite;$(AsBg Green)"
  local bgAttr=$(AsBg $TextAttrBg)
  local footerAttr="$BrightWhite;$bgAttr"

  printf "\e[%sm\n   \e[%sm ≡ %s  \e[0m\n" "$bgAttr" "$headerAttr" "$(PadMiddle "Services" $(( labelWidth + 5 )))"
  for service in "${(ok)SERVICE_LIST[@]}"; do
    local port=${SERVICE_LIST[$service]}
    local color="$dialogAttr"
    if is_port_open "$port"; then
      color="$runAttr"
    fi
    printf "\e[%sm   \e[%sm▌\e[%sm %-*s %5d \e[%sm▐\e[0m\n" "$bgAttr" "$dialogAttr" "$color" "$labelWidth" "$service" "$port" "$dialogAttr"
  done
  printf "\e[%sm   \e[%sm" "$bgAttr" "$footerAttr"
  RepeatChar "▀" $(( labelWidth + 10 ))
  printf "\e[0m\n"
  CursorOn
}

print_line() {
  local line="$1"
  [[ $hide_ports -eq 0 ]] && line="$line:$2"
  [[ $mode == 'all' ]] && {
    if [[ $3 -eq 0 ]]; then
      line="$line RUNNING"
    else
      line="$line stopped"
    fi
  }
  echo "$line"
}

list_print() {
  for service in "${(ok)SERVICE_LIST[@]}"; do
    local port=${SERVICE_LIST[$service]}
    if is_port_open "$port"; then
      [[ $mode == 'running' || $mode == 'all' ]] && print_line "$service" "$port" 0
    else
      [[ $mode == 'stopped' || $mode == 'all' ]] && print_line "$service" "$port" 1
    fi
  done
}

parse_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        show_help
        exit 0
        ;;
      -c|--context)
        [[ -z "${2:-}" || "$2" == -* ]] && {
          ErrorBar "Option -c requires a context name"
          exit 1
        }
        _cli_context="$2"
        shift 2
        ;;
      -a|--all)
        mode=all
        shift
        ;;
      -r|--running)
        mode=running
        shift
        ;;
      -s|--stopped)
        mode=stopped
        shift
        ;;
      -np|--no-ports)
        hide_ports=1
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        show_help
        exit 1
        ;;
    esac
  done
}

main() {
  parse_options "$@"
  resolve_service_list "$_cli_context"

  # Build port map
  for p in $(get_listening_ports); do
    ports[$p]=1
  done

  if (( ${#SERVICE_LIST[@]} == 0 )); then
    ErrorBar "No services found."
    exit 1
  fi

  if [[ $mode == 'pretty' ]]; then
    pretty_print
  else
    list_print
  fi
}

main "$@"
