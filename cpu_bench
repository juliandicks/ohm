#!/bin/zsh

[[ -n "$TURBO_PATH" ]] || { print "🛑Script aborted. TURBO_ZSH missing."; exit 250; }

uses crt_lib.zsh
uses spinner_lib.zsh

set -u

zmodload zsh/datetime 2>/dev/null || true
zmodload zsh/mathfunc 2>/dev/null || true

RUNS=5
TARGET_MS=700
QUIET=0

show_help() {
  cat <<EOF
Usage: cpu_bench [OPTIONS]

Simple CPU benchmark for cross-machine comparison (no install required).

Options:
  -r, --runs N        Number of measured runs per workload (default: ${RUNS})
  -t, --target-ms N   Target milliseconds for calibration run (default: ${TARGET_MS})
  -q, --quiet         Print only final scores
  -h, --help          Show this help message
EOF
}

parse_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -r|--runs)
        RUNS=${2:-}
        shift 2
        ;;
      -t|--target-ms)
        TARGET_MS=${2:-}
        shift 2
        ;;
      -q|--quiet)
        QUIET=1
        shift
        ;;
      -h|--help)
        show_help
        exit 0
        ;;
      *)
        print -u2 -- "Unknown option: $1"
        show_help
        exit 1
        ;;
    esac
  done

  [[ "$RUNS" == <-> ]] || { print -u2 -- "--runs must be an integer"; exit 1; }
  [[ "$TARGET_MS" == <-> ]] || { print -u2 -- "--target-ms must be an integer"; exit 1; }
  (( RUNS > 0 )) || { print -u2 -- "--runs must be > 0"; exit 1; }
  (( TARGET_MS > 0 )) || { print -u2 -- "--target-ms must be > 0"; exit 1; }
}

now_ms() {
  if [[ -n "${EPOCHREALTIME:-}" ]]; then
    local -F t=$EPOCHREALTIME
    print $(( t * 1000 ))
  else
    print $(( $(date +%s) * 1000 ))
  fi
}

run_workload() {
  local mode=$1
  local n=$2

  case "$mode" in
    int)
      awk -v n="$n" '
        BEGIN {
          x = 123456789
          s = 0
          for (i = 0; i < n; i++) {
            x = (x * 1664525 + 1013904223) % 4294967296
            s += (x % 997)
          }
          printf "%.0f\n", s
        }'
      ;;
    float)
      awk -v n="$n" '
        BEGIN {
          x = 0.5
          y = 0
          for (i = 1; i <= n; i++) {
            x = (x * 1.000001) + ((i % 97) * 0.0000003)
            y += x / (1.0 + (i % 19))
          }
          printf "%.6f\n", y
        }'
      ;;
    *)
      return 1
      ;;
  esac
}

measure_ms() {
  local mode=$1
  local n=$2
  local start end elapsed sink
  start=$(now_ms)
  sink=$(run_workload "$mode" "$n")
  end=$(now_ms)
  elapsed=$(( end - start ))
  (( elapsed <= 0 )) && elapsed=1
  print "$elapsed"
}

calibrate_iters() {
  local mode=$1
  local iters=200000
  local elapsed=0
  local i scaled

  for i in 1 2 3; do
    elapsed=$(measure_ms "$mode" "$iters")
    (( elapsed <= 0 )) && elapsed=1
    integer scaled=$(( (iters * TARGET_MS) / elapsed ))
    (( scaled < 10000 )) && scaled=10000
    iters=$scaled
  done
  print "$iters"
}

median_ms() {
  local -a vals=("$@")
  local -a sorted
  local idx
  sorted=("${(@on)vals}")
  idx=$(( (${#sorted[@]} + 1) / 2 ))
  print "${sorted[$idx]}"
}

run_suite() {
  local mode=$1
  local iters elapsed med
  local -a samples
  local i

  iters=$(calibrate_iters "$mode")
  run_workload "$mode" "$iters" >/dev/null 2>&1

  for (( i = 1; i <= RUNS; i++ )); do
    elapsed=$(measure_ms "$mode" "$iters")
    samples+=("$elapsed")
  done

  med=$(median_ms "${samples[@]}")
  print "$mode $iters $med"
}

print_header() {
  (( QUIET == 1 )) && return 0
  print "CPU Bench"
  print "Runs: ${RUNS}  Target: ${TARGET_MS}ms"
}

format_human_score() {
  local value=$1
  local value=$1
  local result
  
  if (( value >= 1000000000 )); then
    result=$(printf "%.2f" $((value / 1000000000.0)))B
  elif (( value >= 1000000 )); then
    result=$(printf "%.2f" $((value / 1000000.0)))M
  elif (( value >= 1000 )); then
    result=$(printf "%.2f" $((value / 1000.0)))K
  else
    result=$(printf "%.0f" $value)
  fi
  
  print -n "$result"
}

format_ms_1dp() {
  printf "%.1f" "$1"
}

fill_char() {
  local n=$1
  local ch=$2
  local out=""
  local i
  for (( i = 0; i < n; i++ )); do
    out+="$ch"
  done
  print -r -- "$out"
}

pretty_print() {
  local runs="${1-}"; shift || true
  local target_ms="${1-}"; shift || true
  local int_iters="${1-}"; shift || true
  local int_ms="${1-}"; shift || true
  local int_score_h="${1-}"; shift || true
  local float_iters="${1-}"; shift || true
  local float_ms="${1-}"; shift || true
  local float_score_h="${1-}"; shift || true
  local composite_h="${1-}"
  local int_ms_display
  local float_ms_display

  local tHDR="30;107"
  local tDLG="97;44"
  local tFLD="93"
  local bg="40"
  local tDLGB="97;40"
  local innerW=60
  local dlgW=$(( innerW + 8 ))
  local section_fill=$(( dlgW - 19 ))
  local border_fill=$(( dlgW - 8 ))
  local header="CPU Benchmark"
  local section_bar
  local border_bar
  local bottom_bar

  (( section_fill < 1 )) && section_fill=1
  (( border_fill < 1 )) && border_fill=1
  section_bar=$(fill_char "$section_fill" "─")
  border_bar=$(fill_char "$border_fill" "─")
  bottom_bar=$(fill_char "$((dlgW-4))" "▀")
  int_ms_display=$(format_ms_1dp "$int_ms")
  float_ms_display=$(format_ms_1dp "$float_ms")

  printf "\n\e[%sm   \e[%sm ≡ %s \e[0m\n" "$bg" "$tHDR" "$(printf '%-60s' "$header")"
  printf "\e[%sm   \e[%sm▌┌ \e[%smBenchmark\e[%sm %s┐▐\e[0m\n" "$bg" "$tDLG" "$tFLD" "$tDLG" "$section_bar"
  printf "\e[%sm   \e[%sm▌│ %-58s │▐\e[0m\n" "$bg" "$tDLG" "Runs: ${runs}   Target: ${target_ms}ms"
  printf "\e[%sm   \e[%sm▌│ %-58s │▐\e[0m\n" "$bg" "$tDLG" "Integer   iters=${int_iters} median=${int_ms_display}ms score=${int_score_h}"
  printf "\e[%sm   \e[%sm▌│ %-58s │▐\e[0m\n" "$bg" "$tDLG" "Float     iters=${float_iters} median=${float_ms_display}ms score=${float_score_h}"
  printf "\e[%sm   \e[%sm▌│ %-58s │▐\e[0m\n" "$bg" "$tDLG" "CPU_SCORE ${composite_h}"
  printf "\e[%sm   \e[%sm▌└%s┘▐\e[0m\n" "$bg" "$tDLG" "$border_bar"
  printf "\e[%sm   \e[%sm%s\e[0m\n" "$bg" "$tDLGB" "$bottom_bar"
}

main() {
  parse_options "$@"

  CursorOff
  SpinnerStart "Thinking..."

  local int_mode int_iters int_ms
  local float_mode float_iters float_ms
  local int_score float_score composite
  local int_score_h float_score_h composite_h

  read -r int_mode int_iters int_ms <<< "$(run_suite int)"
  read -r float_mode float_iters float_ms <<< "$(run_suite float)"

  int_score=$(( (int_iters * 1000) / int_ms ))
  float_score=$(( (float_iters * 1000) / float_ms ))
  composite=$(printf "%.0f" $(( sqrt(int_score * float_score) )))
  int_score_h=$(format_human_score "$int_score")
  float_score_h=$(format_human_score "$float_score")
  composite_h=$(format_human_score "$composite")

  SpinnerStop
  if (( QUIET == 0 )); then
    pretty_print "$RUNS" "$TARGET_MS" "$int_iters" "$int_ms" "$int_score_h" "$float_iters" "$float_ms" "$float_score_h" "$composite_h"
  else
    print "CPU_SCORE=${composite}"
  fi
  CursorOn
}

main "$@"
