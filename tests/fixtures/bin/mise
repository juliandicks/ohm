#!/bin/sh
# Fake mise for tests. MISE_FAKE_MODE: json (default) | untrusted | broken | empty
# MISE_FAKE_JSON: file to print for `tasks ls --json`; MISE_FAKE_LOG: file that records every call;
# MISE_FAKE_OUT: file that `run <task>` writes the task name (and args) to.
[ -n "$MISE_FAKE_LOG" ] && echo "$*" >> "$MISE_FAKE_LOG"
case "$1" in
  tasks)
    case "${MISE_FAKE_MODE:-json}" in
      untrusted) echo 'mise ERROR Config files in /tmp/x/mise.toml are not trusted. Trust them with `mise trust`.' >&2; exit 1 ;;
      broken)    echo 'mise ERROR something unexpected happened' >&2; exit 1 ;;
      empty)     echo '[]' ;;
      *)         cat "$MISE_FAKE_JSON" ;;
    esac ;;
  run)
    shift
    [ -n "$MISE_FAKE_OUT" ] && echo "ran: $*" > "$MISE_FAKE_OUT"
    echo "fake mise ran $*"
    [ -n "$MISE_FAKE_RUN_STDERR" ] && echo "$MISE_FAKE_RUN_STDERR" >&2
    exit "${MISE_FAKE_RUN_STATUS:-0}" ;;
  *) echo "fake mise: unsupported: $*" >&2; exit 64 ;;
esac
