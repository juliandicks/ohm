#!/bin/zsh
# shellcheck disable=SC2051,SC2079,SC2324,SC2128

[[ -n "$TURBO_PATH" ]] || { print "🛑Script aborted. TURBO_ZSH missing."; exit 250; }

uses crt_lib.zsh

# Stateful Linux sampler data for diff-based usage.
global -i _cpu_prev_total=-1
global -i _cpu_prev_idle=-1

# Function to get CPU usage on Linux
get_cpu_usage_linux() {
    local cpu user nice system idle iowait irq softirq steal guest guest_nice
    # shellcheck disable=SC2034
    if ! read -r cpu user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat; then
        echo "0"
        return
    fi

    # Count iowait with idle for a more stable "busy" percentage.
    local -i idle_now=$(( ${idle:-0} + ${iowait:-0} ))
    local -i total_now=$(( ${user:-0} + ${nice:-0} + ${system:-0} + idle_now + ${irq:-0} + ${softirq:-0} + ${steal:-0} + ${guest:-0} + ${guest_nice:-0} ))

    if (( _cpu_prev_total < 0 || _cpu_prev_idle < 0 )); then
        _cpu_prev_total=$total_now
        _cpu_prev_idle=$idle_now
        echo "0"
        return
    fi

    local -i idle_diff=$(( idle_now - _cpu_prev_idle ))
    local -i total_diff=$(( total_now - _cpu_prev_total ))
    _cpu_prev_total=$total_now
    _cpu_prev_idle=$idle_now

    if (( total_diff <= 0 )); then
        echo "0"
        return
    fi

    local -i usage=$(( (100 * (total_diff - idle_diff)) / total_diff ))
    (( usage < 0 )) && usage=0
    (( usage > 100 )) && usage=100
    echo "$usage"
}

# Function to get CPU usage on macOS
get_cpu_usage_mac() {
    local idle
    idle=$(top -l 1 -n 0 2>/dev/null | awk -F'[:,% ]+' '/CPU usage/ {for (i=1; i<=NF; i++) if ($i=="idle") {print $(i-1); exit}}')
    if [[ -z $idle ]]; then
        echo "0"
        return
    fi

    local -F 2 usage=$((100.0 - idle))
    (( usage < 0.0 )) && usage=0.0
    (( usage > 100.0 )) && usage=100.0
    printf "%d\n" $(( usage + 0.5 ))
}

# Function to get CPU usage based on OS
get_cpu_usage() {
    case "$(uname)" in
        Darwin)
            get_cpu_usage_mac
            ;;
        Linux)
            get_cpu_usage_linux
            ;;
        *)
            echo "0" # Unknown OS
            ;;
    esac
}

# Theme definitions
typeset -A dotsMap blockMap pieMap

# shellcheck disable=SC2190,SC2034
dotsMap=(
  "00" "⠀"
  "01" "⢀"
  "02" "⢠"
  "03" "⢰"
  "04" "⢸"
  "10" "⡀"
  "11" "⣀"
  "12" "⣠"
  "13" "⣰"
  "14" "⣸"
  "20" "⡄"
  "21" "⣄"
  "22" "⣤"
  "23" "⣴"
  "24" "⣼"
  "30" "⡆"
  "31" "⣆"
  "32" "⣦"
  "33" "⣶"
  "34" "⣾"
  "40" "⡇"
  "41" "⣇"
  "42" "⣧"
  "43" "⣷"
  "44" "⣿"
)

# shellcheck disable=SC2190,SC2034
blockMap=(
  "0" " "
  "1" "▁"
  "2" "▂"
  "3" "▃"
  "4" "▄"
  "5" "▅"
  "6" "▆"
  "7" "▇"
  "8" "█"
)

# shellcheck disable=SC2190,SC2034
pieMap=(
  "0" " "
  "1" "⚬"
  "2" "○"
  "3" "◔"
  "4" "◑"
  "5" "◕"
  "6" "●"
)

show_help() {
  cat <<EOF
Usage: cpu_graph [OPTIONS]

Display a real-time CPU usage graph in the terminal.

Options:
  -w, --width <num>      Graph width in characters (default: 32, range: 16-128)
  -t, --theme <name>     Display theme: dots, block, pie (default: dots)
  -h, --help             Show this help message

Themes:
  dots    Compact dual-bar dots characters (5 levels)
  block   Block elements with 9 levels (space to full block)
  pie     Circle/Pie density representation (9 levels)

Press any key to exit the graph display.

Examples:
  cpu_graph                    # Default: 32 width, dots theme
  cpu_graph -w 64              # 64 character width
  cpu_graph -t block           # Use block theme
  cpu_graph -w 80 -t pie       # 80 width with pie theme
EOF
}

main() {
  emulate -L zsh
  setopt localoptions no_xtrace no_verbose typesetsilent

  # Default values
  local width=32
  local theme="dots"
  local charMap
  local levels=5
  local chars_per_sample=2

  # Parse command line arguments
  while [[ $# -gt 0 ]]; do
    case $1 in
      -h|--help)
        show_help
        return 0
        ;;
      -w|--width)
        if [[ -z $2 || $2 == -* ]]; then
          print "Error: --width requires a numeric argument" >&2
          return 1
        fi
        width=$2
        shift 2
        ;;
      -t|--theme)
        if [[ -z $2 || $2 == -* ]]; then
          print "Error: --theme requires an argument (dots, block, or pie)" >&2
          return 1
        fi
        theme=$2
        shift 2
        ;;
      *)
        # Backward compatibility: numeric first argument sets width
        if [[ $1 =~ ^[0-9]+$ ]] && [[ $# -eq 1 ]]; then
          width=$1
          shift
        else
          print "Error: Unknown option: $1" >&2
          print "Use --help for usage information" >&2
          return 1
        fi
        ;;
    esac
  done

  # Validate width
  if (( width < 16 )); then
    width=16
  elif (( width > 128 )); then
    width=128
  fi

  # Select theme and set parameters
  case $theme in
    dots)
      charMap=dotsMap
      levels=5
      chars_per_sample=2
      ;;
    block)
      charMap=blockMap
      levels=9
      chars_per_sample=1
      ;;
    pie)
      charMap=pieMap
      levels=7
      chars_per_sample=1
      ;;
    *)
      print "Error: Unknown theme '$theme'. Valid themes: dots, block, pie" >&2
      return 1
      ;;
  esac

  local history_len=$width

  # Initialize history string with zeros
  local history=$(printf '0%.0s' {1..$history_len})
  local len=${#history}
  local pair=""
  local i=0

  _cleanup_cpu_graph() {
      ResetColor
      printf "\n"
  }
  trap '_cleanup_cpu_graph' EXIT TERM

  while true; do
      local usage=$(get_cpu_usage)
      local mapped=$(( usage * levels / 101 ))
      history+=$mapped
      history=${history[2,-1]}

      local result=""
      if [[ $chars_per_sample -eq 2 ]]; then
        # dots: 2 samples per character
        for ((i=1; i<=len; i+=2)); do
          pair=${history[i, i+1]}
          # shellcheck disable=SC2298,SC2296
          result+=${${(P)charMap}[$pair]}
        done
      else
        # Block/Pie: 1 sample per character
        for ((i=1; i<=len; i++)); do
          pair=${history[i]}
          # shellcheck disable=SC1087,SC2296,SC2298
          result+=${${(P)charMap}[$pair]}
        done
      fi

      printf " [\e[32m%s\e[0m] %3d%%\r" "${result}" "$usage"

      # Check for key press with 1 second timeout (suppress output)
      if read -t 1 -k 1 -s 2>/dev/null; then
          break
      fi
  done
}

main "$@"
