#!/bin/zsh

[[ -n "$TURBO_PATH" ]] || { print "🛑Script aborted. TURBO_ZSH missing."; exit 250; }

uses crt_lib.zsh

# Stateful Linux sampler data for diff-based usage.
typeset -gi _cpu_prev_total=-1
typeset -gi _cpu_prev_idle=-1

# Function to get CPU usage on Linux
get_cpu_usage_linux() {
    local cpu user nice system idle iowait irq softirq steal guest guest_nice
    if ! read -r cpu user nice system idle iowait irq softirq steal guest guest_nice < /proc/stat; then
        echo "0"
        return
    fi

    # Count iowait with idle for a more stable "busy" percentage.
    local -i idle_now=$(( ${idle:-0} + ${iowait:-0} ))
    local -i total_now=$(( ${user:-0} + ${nice:-0} + ${system:-0} + idle_now + ${irq:-0} + ${softirq:-0} + ${steal:-0} + ${guest:-0} + ${guest_nice:-0} ))

    if (( _cpu_prev_total < 0 || _cpu_prev_idle < 0 )); then
        _cpu_prev_total=$total_now
        _cpu_prev_idle=$idle_now
        echo "0"
        return
    fi

    local -i idle_diff=$(( idle_now - _cpu_prev_idle ))
    local -i total_diff=$(( total_now - _cpu_prev_total ))
    _cpu_prev_total=$total_now
    _cpu_prev_idle=$idle_now

    if (( total_diff <= 0 )); then
        echo "0"
        return
    fi

    local -i usage=$(( (100 * (total_diff - idle_diff)) / total_diff ))
    (( usage < 0 )) && usage=0
    (( usage > 100 )) && usage=100
    echo "$usage"
}

# Function to get CPU usage on macOS
get_cpu_usage_mac() {
    local idle
    idle=$(top -l 1 -n 0 2>/dev/null | awk -F'[:,% ]+' '/CPU usage/ {for (i=1; i<=NF; i++) if ($i=="idle") {print $(i-1); exit}}')
    if [[ -z $idle ]]; then
        echo "0"
        return
    fi

    local -F 2 usage=$((100.0 - idle))
    (( usage < 0.0 )) && usage=0.0
    (( usage > 100.0 )) && usage=100.0
    printf "%d\n" $(( usage + 0.5 ))
}

# Function to get CPU usage based on OS
get_cpu_usage() {
    case "$(uname)" in
        Darwin)
            get_cpu_usage_mac
            ;;
        Linux)
            get_cpu_usage_linux
            ;;
        *)
            echo "0" # Unknown OS
            ;;
    esac
}

# Function to display CPU usage with a green bar
display_usage_bar() {
    local usage=$1
    local bar_length=50
    local filled=$((usage * bar_length / 100))

    # Build the bar
    local bar=$(printf "%${filled}s" | tr ' ' '#')
    local empty=$(printf "%$((bar_length - filled))s")

    # Print the bar
    printf "[\e[32m%s\e[0m%s] %3d%%\n" "${bar}" "${empty}" "$usage"
}

typeset -A charMap
# shellcheck disable=SC2190,SC2034
charMap=(
  "00" "⠀"
  "01" "⢀"
  "02" "⢠"
  "03" "⢰"
  "04" "⢸"
  "10" "⡀"
  "11" "⣀"
  "12" "⣠"
  "13" "⣰"
  "14" "⣸"
  "20" "⡄"
  "21" "⣄"
  "22" "⣤"
  "23" "⣴"
  "24" "⣼"
  "30" "⡆"
  "31" "⣆"
  "32" "⣦"
  "33" "⣶"
  "34" "⣾"
  "40" "⡇"
  "41" "⣇"
  "42" "⣧"
  "43" "⣷"
  "44" "⣿"
)

main() {
  emulate -L zsh
  setopt localoptions no_xtrace no_verbose typesetsilent

  # Parse history length parameter (default 32, range 32-128)
  local history_len=${1:-32}
  if (( history_len < 32 )); then
    history_len=32
  elif (( history_len > 128 )); then
    history_len=128
  fi

  # Initialize history string with zeros
  local history=$(printf '0%.0s' {1..$history_len})
  local len=${#history}
  local pair=""
  local i=0

  _cleanup_cpu_graph() {
      ResetColor
      printf "\n"
  }
  trap '_cleanup_cpu_graph' EXIT TERM

  while true; do
      local usage=$(get_cpu_usage)
      local mapped=$(( usage * 5 / 101 ))
      # shellcheck disable=SC2324
      history+=$mapped
      history=${history[2,-1]}

      local result=""
      for ((i=1; i<=len; i+=2)); do
        pair=${history[i, i+1]}     # Zsh slice: 2 chars
        result+=$charMap[$pair]         # append mapped char
      done

      printf "[\e[32m%s\e[0m] %3d%%\r" "${result}" "$usage"

      # Check for key press with 1 second timeout (suppress output)
      if read -t 1 -k 1 -s 2>/dev/null; then
          break
      fi
  done
}

main "$@"
